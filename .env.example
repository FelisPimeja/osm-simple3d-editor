# Скопируйте в .env.local и вставьте client_id OAuth 2.0-приложений.
# Регистрация: <сервер>/oauth2/applications/new, права: read_prefs, write_prefs (настройки пользователя в профиле), write_api,
# redirect URI: адрес приложения + oauth.html (например http://127.0.0.1:5174/oauth.html).
# client_id не секрет (PKCE, без client_secret) — его можно коммитить для сборки на GitHub Pages.
VITE_OSM_DEV_CLIENT_ID=
VITE_OSM_CLIENT_ID=
VITE_OGF_CLIENT_ID=
VITE_OHM_CLIENT_ID=
# Необязательно: публичный токен Mapbox (pk.…, лучше с ограничением по адресу сайта) — подложка Mapbox Satellite.
VITE_MAPBOX_TOKEN=
# Необязательно: клиентский токен Mapillary (MLY|…, https://www.mapillary.com/dashboard/developers) — слой уличных фото Mapillary.
VITE_MAPILLARY_TOKEN=
